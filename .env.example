GEMINI_API_KEY=AIzaSyBp9pS0-XO7_9USFt3_mpr-pDP_UM0l6Jc

# ── Twilio (SMS Reminders) ─────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
